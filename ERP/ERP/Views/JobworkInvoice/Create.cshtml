                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <!-- BODY -->
                <div class="modal-body">
                    <table class="table table-bordered table-hover">

                        <thead>
                            <tr class="table-info">
                                <th>Type</th>
                                <th>Address ID</th>
                                <th>Address</th>
                                <th>City</th>
                                <th>State</th>
                                <th>Country</th>
                                <th>PIN</th>
                                <th>GSTIN</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody id="AddTableBody">

                            <!-- 🔥 TEMPLATE ROW (USED FOR CLONE ONLY) -->
                            <tr id="AddTempRow" style="display:none">

                                <td>
                                    <select class="form-select JIDNA_ADTP_Number"
                                            asp-items="@ViewBag.AddressType"></select>
                                </td>

                                <td>
                                    <select class="form-select JIDNA_Address_ID"
                                            asp-items="@ViewBag.AddressID"></select>
                                </td>

                                <td><input class="form-control JIDNA_Address" readonly></td>
                                <td><input class="form-control JIDNA_City" readonly></td>
                                <td><input class="form-control JIDNA_State" readonly></td>
                                <td><input class="form-control JIDNA_Country" readonly></td>
                                <td><input class="form-control JIDNA_PIN" readonly></td>
                                <td><input class="form-control JIDNA_GSTIN" readonly></td>

                                <td>
                                    <input type="hidden" class="JIDNA_Number" value="0">
                                    <input type="hidden" class="JIDNA_IsDeleted" value="0">
                                    <a class="AddRowRemove btn text-danger">🗑</a>
                                </td>

                            </tr>


                            <!-- 🔥 FIRST ROW (ALWAYS SHOWN EMPTY ROW) -->
                            <tr class="AddNewRow">

                                <td>
                                    <select class="form-select JIDNA_ADTP_Number"
                                            asp-items="@ViewBag.AddressType"></select>
                                </td>

                                <td>
                                    <select class="form-select JIDNA_Address_ID"
